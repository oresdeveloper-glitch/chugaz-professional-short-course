# ─── SMTP (Password Reset Emails) ───────────────────────────
# Pick ONE method:

# Option A: Gmail (requires App Password)
# 1. Enable 2FA at https://myaccount.google.com/security
# 2. Generate App Password at https://myaccount.google.com/apppasswords
# 3. Copy the 16-character password below
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop

# Option B: Any SMTP provider (SendGrid, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your_sendgrid_api_key

# ─── Custom Data Directory (optional) ───────────────────────
# Defaults to ./data/ in project root (persists on HF Spaces)
# On Vercel, /tmp/ is used automatically
# CHUGAZ_DATA_DIR=/path/to/data
